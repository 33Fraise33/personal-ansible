http:
  services:
{% for rule in traefik_custom_rules %}
    {{ rule.name }}:
        loadBalancer:
          servers:
            - url: "{{ rule.target }}"
{% endfor %}
  routers:
{% for rule in traefik_custom_rules %}
    {{ rule.name }}:
        rule: "Host(`{{ rule.name }}.frai.se`)"
        service: "{{ rule.name }}"
{% if rule.management_only | default(false) %}
        middlewares:
          - management-only
{% endif %}
        tls:
          certResolver: le
          domains:
            - main: "*.frai.se"
{% endfor %}
  middlewares:
{% if traefik_internal_default | default(false) | bool %}
    internal-only:
      ipAllowList:
        sourceRange:
{% for item in firewall_sets_all if item.name in ['RFC1918', 'AS211184'] %}
{% for cidr in item.elements %}
          - "{{ cidr }}"
{% endfor %}
{% endfor %}
{% endif %}
    management-only:
      ipAllowList:
        sourceRange:
{% for item in firewall_sets_all if item.name in ['MGMT', 'v6_MGMT'] %}
{% for cidr in item.elements %}
          - "{{ cidr }}"
{% endfor %}
{% endfor %}
    auth-unitix:
      forwardAuth:
        maxBodySize: 1048576
        maxResponseBodySize: 1048576
        address: "https://auth.unitix.be/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - "Remote-User"
          - "Remote-Groups"
          - "Remote-Name"
          - "Remote-Email"
    auth-fraise:
      forwardAuth:
        maxBodySize: 1048576
        maxResponseBodySize: 1048576
        address: "https://auth.frai.se/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - "Remote-User"
          - "Remote-Groups"
          - "Remote-Name"
          - "Remote-Email"
    corsheaders:
      headers:
        accessControlAllowMethods:
          - GET
          - OPTIONS
          - PUT
        accessControlAllowHeaders: "*"
        accessControlAllowOriginList:
          - https://frai.se
{% if traefik_tcp_routers | default([]) | length > 0 %}
tcp:
  routers:
{% for router in traefik_tcp_routers %}
    {{ router.name }}:
      entryPoints:
{% for entrypoint in router.entrypoints %}
        - {{ entrypoint | to_json }}
{% endfor %}
      rule: {{ router.rule | to_json }}
      service: {{ router.name | to_json }}
{% if router.tls_passthrough | default(false) | bool %}
      tls:
        passthrough: true
{% endif %}
{% endfor %}
  services:
{% for router in traefik_tcp_routers %}
    {{ router.name }}:
      loadBalancer:
        servers:
          - address: {{ router.target | to_json }}
{% if router.proxy_protocol_version is defined %}
        proxyProtocol:
          version: {{ router.proxy_protocol_version }}
{% endif %}
{% endfor %}
{% endif %}
